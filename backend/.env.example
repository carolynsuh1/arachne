OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PIPELINE_MODEL=gpt-5.6-terra
DEEPGRAM_API_KEY=
# Optional Deepgram Aura voice used by continuous Voice Agent sessions.
DEEPGRAM_VOICE_MODEL=aura-2-thalia-en
# Prerecorded transcription prefers Deepgram Nova-3, then falls back to
# OPENAI_API_KEY (Whisper) when available.

# Optional. When set, every request except /health must send it as X-Internal-Key
# (the Arachne Next.js app does, using its own INTERNAL_API_KEY). Leave empty for the Vite app.
INTERNAL_API_KEY=
