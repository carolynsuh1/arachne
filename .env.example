# Copy to .env and fill in. Never commit .env.
# SQLite database file (path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Cookie-encryption secret for iron-session. Must be 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-random-string-of-32-plus-chars"
# Where uploaded resumes are stored on disk (outside /public). Relative to the project root.
UPLOAD_DIR="uploads"
