# Copy to .env and fill in. Never commit .env.
# SQLite database file (path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Cookie-encryption secret for iron-session. Must be 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-random-string-of-32-plus-chars"
# Where uploaded resumes are stored on disk (outside /public). Relative to the project root.
UPLOAD_DIR="uploads"
# URL of the team's Vite app (frontend/), used by the "Open team app" links on /map.
NEXT_PUBLIC_TEAM_APP_URL="http://localhost:5173"

# --- Team backend (backend/, FastAPI) ---
# Where the Next.js server reaches the team's API. The browser never calls it directly.
TEAM_API_URL="http://127.0.0.1:8000"
# Optional shared secret. If set here AND in backend/.env, the backend rejects requests without it.
# Leave empty in local dev (the team's Vite app does not send it).
INTERNAL_API_KEY=""
